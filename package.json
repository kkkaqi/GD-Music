{
  "name": "gd-music-desktop",
  "version": "1.0.8",
  "private": true,
  "description": "GD Music —— 基于 Electron + Vue 3 的桌面音乐播放器",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:electron": "npm run build && node scripts/test-electron.cjs",
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && node scripts/launch.js",
    "app": "node scripts/launch.js",
    "shot": "node scripts/launch.js --shot",
    "dev:electron": "node scripts/launch.js --dev",
    "dist": "npm run build && node scripts/package.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  }
}
